import { createFileRoute, useSearch } from "@tanstack/react-router";
import { useEffect, useMemo, useState } from "react";
import { AdminLayout, AdminPageHeader } from "@/components/admin/AdminLayout";
import {
  listUsers,
  type AdminUser,
} from "@/services/adminUserService";
import {
  listPermissions,
  type BackendPermission,
} from "@/services/permissionService";
import {
  setAdminPermissions,
} from "@/services/adminAccountService";
import {
  Loader2,
  ShieldCheck,
  Check,
  Search,
  Save,
  User,
} from "lucide-react";

export const Route = createFileRoute("/admin/permissions")({
  validateSearch: (search: Record<string, unknown>) => ({
    user:
      typeof search.user === "string"
        ? search.user
        : undefined,
  }),

  head: () => ({
    meta: [
      { title: "Permissions" },
      { name: "robots", content: "noindex" },
    ],
  }),

  component: PermissionsAdmin,
});

function PermissionsAdmin() {
  const search = useSearch({ from: "/admin/permissions" });

  const [users, setUsers] = useState<AdminUser[]>([]);
  const [permissions, setPermissions] = useState<BackendPermission[]>([]);
  const [selectedUserId, setSelectedUserId] = useState("");
  const [selectedPermissions, setSelectedPermissions] =
    useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");
  const [userSearch, setUserSearch] = useState("");

  async function load() {
    try {
      setError("");
      setLoading(true);

      const [loadedUsers, loadedPermissions] = await Promise.all([
        listUsers(),
        listPermissions(),
      ]);

      setUsers(loadedUsers);

      /*
       * These permission modules remain available in the backend.
       * They are hidden ONLY from the frontend Permissions page.
       *
       * Backend permissions are NOT deleted or modified.
       *
       * Hidden from this page:
       * - Feedback
       * - Activity
       * - Media Library
       * - Admin Accounts
       * - Announcement
       * - Announcements
       *
       * Multimedia is intentionally NOT hidden.
       */
      const HIDDEN_PERMISSION_MODULES = new Set([
        "feedback",
        "activity",
        "media",
        "admin_accounts",
        "announcement",
        "announcements",
      ]);

      const visiblePermissions = loadedPermissions.filter(
        (permission) =>
          !HIDDEN_PERMISSION_MODULES.has(
            permission.module.trim().toLowerCase(),
          ),
      );

      setPermissions(visiblePermissions);

      /*
       * Select requested user when supplied in the URL.
       */
      const requestedUser: AdminUser | undefined = search.user
        ? loadedUsers.find(
            (user) => user.id === search.user,
          )
        : undefined;

      /*
       * Otherwise select the first Admin account.
       */
      const firstAdmin: AdminUser | undefined =
        requestedUser?.role === "admin"
          ? requestedUser
          : loadedUsers.find(
              (user) => user.role === "admin",
            );

      /*
       * Keep the currently selected account if possible.
       */
      const userToSelect: AdminUser | undefined =
        requestedUser ??
        (selectedUserId
          ? loadedUsers.find(
              (user) => user.id === selectedUserId,
            )
          : undefined) ??
        firstAdmin;

      if (userToSelect) {
        setSelectedUserId(userToSelect.id);
        setSelectedPermissions(
          userToSelect.permissions ?? [],
        );
      }
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Unable to load users and permissions.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void load();
  }, [search.user]);

  const selectedUser = useMemo(
    () =>
      users.find(
        (user) => user.id === selectedUserId,
      ) ?? null,
    [users, selectedUserId],
  );

  const filteredUsers = useMemo(() => {
    const q = userSearch.trim().toLowerCase();

    if (!q) {
      return users;
    }

    return users.filter(
      (user) =>
        user.name.toLowerCase().includes(q) ||
        user.email.toLowerCase().includes(q) ||
        user.role.toLowerCase().includes(q),
    );
  }, [users, userSearch]);

  const groupedPermissions = useMemo(() => {
    const groups = new Map<
      string,
      BackendPermission[]
    >();

    for (const permission of permissions) {
      const existing =
        groups.get(permission.module) ?? [];

      existing.push(permission);
      groups.set(permission.module, existing);
    }

    return Array.from(groups.entries());
  }, [permissions]);

  function togglePermission(key: string) {
    if (!selectedUser || selectedUser.role !== "admin") {
      return;
    }

    setSuccess("");

    setSelectedPermissions((current) =>
      current.includes(key)
        ? current.filter(
            (permission) => permission !== key,
          )
        : [...current, key],
    );
  }

  function toggleModule(
    modulePermissions: BackendPermission[],
  ) {
    if (!selectedUser || selectedUser.role !== "admin") {
      return;
    }

    const keys = modulePermissions.map(
      (permission) => permission.key,
    );

    const allSelected = keys.every((key) =>
      selectedPermissions.includes(key),
    );

    setSuccess("");

    if (allSelected) {
      setSelectedPermissions((current) =>
        current.filter(
          (permission) => !keys.includes(permission),
        ),
      );
    } else {
      setSelectedPermissions((current) => [
        ...new Set([
          ...current,
          ...keys,
        ]),
      ]);
    }
  }

  async function savePermissions() {
    if (!selectedUser) {
      return;
    }

    if (selectedUser.role !== "admin") {
      setError(
        "Permissions can only be assigned to Admin accounts.",
      );
      return;
    }

    try {
      setError("");
      setSuccess("");
      setSaving(true);

      /*
       * Save permissions using the existing frontend service.
       *
       * The backend permission definitions are not changed.
       */
      await setAdminPermissions(
        selectedUser.id,
        selectedPermissions,
      );

      setUsers((current) =>
        current.map((user) =>
          user.id === selectedUser.id
            ? {
                ...user,
                permissions: selectedPermissions,
              }
            : user,
        ),
      );

      setSuccess(
        `Permissions updated for ${selectedUser.name}.`,
      );
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Unable to save permissions.",
      );
    } finally {
      setSaving(false);
    }
  }

  function selectUser(user: AdminUser) {
    setSelectedUserId(user.id);
    setSelectedPermissions(
      user.permissions ?? [],
    );
    setSuccess("");
    setError("");
  }

  return (
    <AdminLayout>
      <AdminPageHeader
        title="Users & Permissions"
        description="Select an Admin account and manage the permissions assigned to that account."
      />

      {error && (
        <div className="mb-4 rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
          {error}
        </div>
      )}

      {success && (
        <div className="mb-4 rounded-lg border border-green-500/30 bg-green-500/10 p-3 text-sm text-green-700">
          {success}
        </div>
      )}

      {loading ? (
        <div className="flex items-center justify-center gap-2 rounded-xl border bg-card p-10 text-muted-foreground">
          <Loader2 className="h-4 w-4 animate-spin" />
          Loading users and permissions...
        </div>
      ) : (
        <div className="grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)]">

          {/* USERS */}
          <section className="overflow-hidden rounded-xl border bg-card shadow-soft">
            <div className="border-b p-4">
              <div className="flex items-center gap-2">
                <UsersIcon />

                <div>
                  <h2 className="font-semibold">
                    Staff Accounts
                  </h2>

                  <p className="text-xs text-muted-foreground">
                    Select an Admin to manage access.
                  </p>
                </div>
              </div>

              <div className="relative mt-4">
                <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />

                <input
                  value={userSearch}
                  onChange={(event) =>
                    setUserSearch(event.target.value)
                  }
                  placeholder="Search users..."
                  className="h-9 w-full rounded-lg border bg-background pl-9 pr-3 text-sm outline-none focus:border-primary"
                />
              </div>
            </div>

            <div className="max-h-[650px] overflow-y-auto p-2">
              {filteredUsers.length === 0 ? (
                <div className="p-6 text-center text-sm text-muted-foreground">
                  No users found.
                </div>
              ) : (
                filteredUsers.map((user) => {
                  const selected =
                    user.id === selectedUserId;

                  return (
                    <button
                      key={user.id}
                      type="button"
                      onClick={() => selectUser(user)}
                      className={
                        "mb-1 w-full rounded-lg p-3 text-left transition-colors " +
                        (selected
                          ? "bg-primary/10 ring-1 ring-primary/30"
                          : "hover:bg-secondary")
                      }
                    >
                      <div className="flex items-start gap-3">
                        <div className="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-secondary">
                          <User className="h-4 w-4 text-muted-foreground" />
                        </div>

                        <div className="min-w-0 flex-1">
                          <div className="truncate text-sm font-medium">
                            {user.name}
                          </div>

                          <div className="truncate text-xs text-muted-foreground">
                            {user.email}
                          </div>

                          <div className="mt-1 flex items-center gap-2">
                            <span className="inline-flex items-center gap-1 rounded-full bg-secondary px-2 py-0.5 text-[10px] font-medium">
                              <ShieldCheck className="h-3 w-3" />

                              {user.role === "super_admin"
                                ? "Super Admin"
                                : "Admin"}
                            </span>

                            <span
                              className={
                                "text-[10px] " +
                                (user.is_active
                                  ? "text-green-600"
                                  : "text-muted-foreground")
                              }
                            >
                              {user.is_active
                                ? "Active"
                                : "Disabled"}
                            </span>
                          </div>
                        </div>
                      </div>
                    </button>
                  );
                })
              )}
            </div>
          </section>

          {/* PERMISSIONS */}
          <section className="overflow-hidden rounded-xl border bg-card shadow-soft">
            <div className="border-b p-5">
              {selectedUser ? (
                <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <div className="flex items-center gap-2">
                      <h2 className="font-semibold">
                        Permissions for {selectedUser.name}
                      </h2>

                      <span className="inline-flex items-center gap-1 rounded-full bg-secondary px-2 py-1 text-[10px] font-medium">
                        <ShieldCheck className="h-3 w-3" />

                        {selectedUser.role === "super_admin"
                          ? "Super Admin"
                          : "Admin"}
                      </span>
                    </div>

                    <p className="mt-1 text-xs text-muted-foreground">
                      {selectedUser.role === "super_admin"
                        ? "Super Admin accounts automatically have full access."
                        : "Check or uncheck permissions to control what this Admin can access."}
                    </p>
                  </div>

                  {selectedUser.role === "admin" && (
                    <button
                      type="button"
                      onClick={() =>
                        void savePermissions()
                      }
                      disabled={saving}
                      className="inline-flex h-9 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      {saving ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <Save className="h-4 w-4" />
                      )}

                      {saving
                        ? "Saving..."
                        : "Save Permissions"}
                    </button>
                  )}
                </div>
              ) : (
                <div>
                  <h2 className="font-semibold">
                    Select an account
                  </h2>

                  <p className="mt-1 text-xs text-muted-foreground">
                    Choose an Admin account from the list to manage permissions.
                  </p>
                </div>
              )}
            </div>

            {selectedUser?.role === "super_admin" ? (
              <div className="p-8">
                <div className="rounded-xl border border-primary/20 bg-primary/5 p-6 text-center">
                  <div className="mx-auto grid h-12 w-12 place-items-center rounded-full bg-primary/10">
                    <ShieldCheck className="h-6 w-6 text-primary" />
                  </div>

                  <h3 className="mt-4 font-semibold">
                    Full Access
                  </h3>

                  <p className="mx-auto mt-1 max-w-md text-sm text-muted-foreground">
                    Super Admin accounts have unrestricted access to the administration portal. Individual permission checks are not required.
                  </p>
                </div>
              </div>
            ) : selectedUser?.role === "admin" ? (
              <div className="divide-y">
                {groupedPermissions.map(
                  ([module, modulePermissions]) => {
                    const visibleKeys =
                      modulePermissions.map(
                        (permission) =>
                          permission.key,
                      );

                    const selectedCount =
                      visibleKeys.filter((key) =>
                        selectedPermissions.includes(key),
                      ).length;

                    const allSelected =
                      visibleKeys.length > 0 &&
                      selectedCount ===
                        visibleKeys.length;

                    return (
                      <div
                        key={module}
                        className="p-5"
                      >
                        <div className="mb-3 flex items-center justify-between">
                          <div>
                            <h3 className="font-semibold capitalize">
                              {module.replaceAll(
                                "_",
                                " ",
                              )}
                            </h3>

                            <p className="text-xs text-muted-foreground">
                              {selectedCount} of{" "}
                              {visibleKeys.length} selected
                            </p>
                          </div>

                          <button
                            type="button"
                            onClick={() =>
                              toggleModule(
                                modulePermissions,
                              )
                            }
                            className="text-xs font-medium text-primary hover:underline"
                          >
                            {allSelected
                              ? "Clear all"
                              : "Select all"}
                          </button>
                        </div>

                        <div className="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
                          {modulePermissions.map(
                            (permission) => {
                              const checked =
                                selectedPermissions.includes(
                                  permission.key,
                                );

                              return (
                                <label
                                  key={permission.key}
                                  className={
                                    "flex cursor-pointer items-start gap-3 rounded-lg border p-3 transition-colors " +
                                    (checked
                                      ? "border-primary/40 bg-primary/5"
                                      : "hover:bg-secondary")
                                  }
                                >
                                  <input
                                    type="checkbox"
                                    checked={checked}
                                    onChange={() =>
                                      togglePermission(
                                        permission.key,
                                      )
                                    }
                                    className="mt-0.5 h-4 w-4 accent-primary"
                                  />

                                  <span className="min-w-0">
                                    <span className="block text-sm font-medium">
                                      {permission.action.replaceAll(
                                        "_",
                                        " ",
                                      )}
                                    </span>

                                    <span className="mt-0.5 block truncate font-mono text-[10px] text-muted-foreground">
                                      {permission.key}
                                    </span>

                                    {permission.super_admin_only && (
                                      <span className="mt-1 block text-[10px] text-muted-foreground">
                                        Super Admin only
                                      </span>
                                    )}
                                  </span>

                                  {checked && (
                                    <Check className="ml-auto h-4 w-4 shrink-0 text-primary" />
                                  )}
                                </label>
                              );
                            },
                          )}
                        </div>
                      </div>
                    );
                  },
                )}

                {groupedPermissions.length === 0 && (
                  <div className="p-8 text-center text-sm text-muted-foreground">
                    No assignable permissions are available.
                  </div>
                )}
              </div>
            ) : (
              <div className="p-8 text-center text-sm text-muted-foreground">
                Select an Admin account to manage permissions.
              </div>
            )}
          </section>
        </div>
      )}
    </AdminLayout>
  );
}

function UsersIcon() {
  return (
    <div className="grid h-9 w-9 place-items-center rounded-lg bg-primary/10">
      <User className="h-4 w-4 text-primary" />
    </div>
  );
}